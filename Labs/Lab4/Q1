package main

import "fmt"

type Result struct {
	task  string
	value int
}

func square(n int, ch chan Result) {
	fmt.Println("Square goroutine started")

	ch <- Result{"Square", n * n}

	fmt.Println("Square goroutine completed")
}

func cube(n int, ch chan Result) {
	fmt.Println("Cube goroutine started")

	ch <- Result{"Cube", n * n * n}

	fmt.Println("Cube goroutine completed")
}

func fibonacci(n int, ch chan Result) {
	fmt.Println("Fibonacci goroutine started")

	a, b := 0, 1

	for i := 0; i < n; i++ {
		a, b = b, a+b
	}

	ch <- Result{"Fibonacci", a}

	fmt.Println("Fibonacci goroutine completed")
}

func main() {
	var n int

	fmt.Print("Enter a number: ")
	fmt.Scan(&n)

	ch := make(chan Result)

	go square(n, ch)
	go cube(n, ch)
	go fibonacci(n, ch)

	for i := 0; i < 3; i++ {
		result := <-ch
		fmt.Printf("%s result = %d\n", result.task, result.value)
	}

	fmt.Println("All goroutines finished. Tata bye bye!")
}
